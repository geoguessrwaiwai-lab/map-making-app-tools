{
  "manifest_version": 3,
  "name": "Map Making App Tools",
  "version": "1.5.0",
  "description": "Map Making Appの画面幅調整とロケーション整理を使いやすくします。",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://map-making.app/maps/*"],
      "css": ["resize.css"],
      "js": ["resize.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://map-making.app/maps/*"],
      "css": ["pochipochi.css"],
      "js": ["pochipochi-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://map-making.app/maps/*"],
      "js": ["pochipochi.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://map-making.app/"],
      "css": ["map-list.css"],
      "js": ["map-list.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://map-making.app/maps/*"],
      "css": ["tag-groups.css"],
      "js": ["tag-groups.js"],
      "run_at": "document_idle"
    }
  ]
}
