{
  "manifest_version": 3,
  "name": "Map Making App Tools",
  "version": "1.0.0",
  "description": "Map Making Appのマップ編集画面で、左右ペインの幅をドラッグして変更できるようにします。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://map-making.app/maps/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
